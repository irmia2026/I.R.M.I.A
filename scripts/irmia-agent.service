# Install /opt/irmia-agent from a built checkout. See docs/linux-compatibility.md.
[Unit]
Description=IRMIA resident agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=simple
User=irmia-agent
Group=irmia-agent
StateDirectory=irmia-agent
StateDirectoryMode=0700
WorkingDirectory=/var/lib/irmia-agent
ExecStart=/usr/bin/node /opt/irmia-agent/dist/main.js --config /var/lib/irmia-agent --data-dir /var/lib/irmia-agent/data
EnvironmentFile=-/etc/irmia-agent.env
Environment=NODE_ENV=production
Environment=IRMIA_SYSTEMD_MANAGED=1
Environment=IRMIA_SKILLS_SEED_DIR=/opt/irmia-agent/skills

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=45s

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
