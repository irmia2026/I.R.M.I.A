[
  {
    "name": "enter_channel",
    "description": "显式进一个频道待着：返回该会话最近的消息，之后可用 wait_messages 等新消息（若刚用 read_channel(sid) 看过该会话，已自动进屋，可直接调 wait_messages）。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "sid": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "sid"
      ],
      "additionalProperties": false
    },
    "server": "linre-presence__presence",
    "tool": "enter_channel"
  },
  {
    "name": "wait_messages",
    "description": "在当前频道等新消息（最多 120 秒）：刚用 read_channel(sid) 看过某会话后已自动进屋，可直接调本工具等后续实时消息。有消息立刻返回，没有则等到点。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        }
      },
      "additionalProperties": false
    },
    "server": "linre-presence__presence",
    "tool": "wait_messages"
  },
  {
    "name": "leave_channel",
    "description": "退出当前待着的群。之后不再收这个群的消息，已经看到的不会被收回。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "server": "linre-presence__presence",
    "tool": "leave_channel"
  }
]
