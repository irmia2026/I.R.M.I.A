[
  {
    "name": "sticker_find",
    "server": "linre-stickers__stickers",
    "tool": "sticker_find",
    "description": "检索已审核入库的表情包，返回可直接传给 send_media 的路径与标签。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "关键词或描述。"
        },
        "emotion": {
          "type": "string",
          "enum": [
            "开心",
            "难过",
            "担心",
            "生气",
            "亲近",
            "好奇",
            "无语",
            "得意",
            "害羞"
          ],
          "description": "按情绪分类筛选。"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "返回数量上限，默认 5。"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "sticker_steal",
    "server": "linre-stickers__stickers",
    "tool": "sticker_steal",
    "description": "把本地图片收录进表情包待审核库（默认 pending，审核通过后才会推荐）。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "filePath": {
          "type": "string",
          "description": "本机图片文件路径。"
        },
        "caption": {
          "type": "string",
          "description": "简短描述。"
        },
        "emotion": {
          "type": "string",
          "enum": [
            "开心",
            "难过",
            "担心",
            "生气",
            "亲近",
            "好奇",
            "无语",
            "得意",
            "害羞"
          ],
          "description": "情绪分类。"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "检索标签列表。"
        }
      },
      "additionalProperties": false
    }
  }
]
