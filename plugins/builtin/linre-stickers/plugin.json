{
  "apiVersion": 2,
  "id": "linre-stickers",
  "version": "0.2.1",
  "engine": {
    "irmia": ">=0.1.0-beta.14"
  },
  "contributions": {
    "skills": [
      "skills"
    ],
    "mcp": "mcp.json",
    "tools": "tools.json",
    "events": {
      "namespace": "linre-stickers"
    },
    "adapters": [
      {
        "worker": "adapter-worker.mjs",
        "apiVersion": 2,
        "capabilities": [
          "event.observe",
          "event.publish",
          "model.invoke",
          "prompt.inject",
          "asset.store",
          "asset.resolve",
          "ui.api"
        ]
      }
    ],
    "views": [
      {
        "id": "stickers",
        "title": "表情包",
        "icon": "emoji",
        "subtitle": "自动偷图、AI分类、待审工作台与黑名单管理"
      }
    ]
  },
  "permissions": []
}
