node_modules/
dist/
data/
# 工具的工作根（agent-loop 的 workspaceRoot 默认取 cwd）：她下载与写出的文件都落在这里，
# 属于运行时产物。注意它与 data/workspace/（记忆与人格资产）不是一个目录。
workspace/
.bench-tmp/
*.log
# 本机配置：含 owner 名、联系人表与机器路径，只进版本库之外的 config.json；
# 仓库里给的是 config.example.json。密钥另在 data/.keys.json（data/ 已忽略）。
config.json
# Flutter/Dart 构建产物
gui/build/
gui/.dart_tool/
gui/.flutter-plugins-dependencies
gui/windows/flutter/ephemeral/
# 外部素材与抓取缓存（不属于代码本体）
_research/
_research/maidkit/
_shots/
astrbot-src/
qqbot-cache/
# 品牌资产的拟合中间产物（.npy、比对截图、参考位图），只留几何源与导出物
brand/_analysis/

# ── 本地出包工具链（不进公开仓库）────────────────────────────────────────────
# 这些是 release/installer 的开发脚手架和私有资源：包含本机路径、私有 wheel、
# 角色包与发布闸门。保留在开发树里直接可用，但绝不进入 Git 历史或公开发布。
/packaging/
/packs/
/tools/release.ps1
/tools/package-gate.ps1
/tools/make-config-example.ps1
/tools/sanitize-audit.mjs
/tools/sanitize-archive.mjs
/tools/sanitize-rules.mjs
/tools/publish-oss.mjs
